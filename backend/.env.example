# --- Required: one key for every model (OpenAI, Anthropic, Gemini via OpenRouter) ---
OPENROUTER_API_KEY=sk-or-v1-...

# Optional OpenRouter settings
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_APP_URL=https://your-site.example          # attribution shown in the OpenRouter dashboard
# OPENROUTER_APP_TITLE=screenshot-to-code

# Image generation / editing (OpenRouter Images API). Any slug from
# https://openrouter.ai/models?output_modalities=image works.
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# OPENROUTER_IMAGE_EDIT_MODEL=google/gemini-2.5-flash-image

# Asset extraction (bounding boxes) — a Gemini model via OpenRouter
# ASSET_EXTRACTION_MODEL=google/gemini-3.6-flash

# Optional: Replicate powers `remove_backgrounds` only (no OpenRouter equivalent)
# REPLICATE_API_KEY=r8_...

# Optional tuning
# GENERATION_MAX_COST_USD=3.0     # per-variant spend ceiling (from OpenRouter usage accounting)
# AGENT_MAX_STEPS=30              # max model calls per variant
# S2C_MODEL_SET=default           # default | gemini | anthropic | openai
# PROMPT_REPORTS_ENABLED=false    # write full run logs to run_logs/ (viewable at /evals)
# S2C_CHROMIUM_EXECUTABLE=        # use a specific Chromium binary for screenshot_preview

# Development without any key: scripted fake model instead of OpenRouter
# S2C_FAKE_MODEL=1
